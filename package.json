    "fflate": "^0.8.3",
    "katex": "^0.18.10",
    "lucide-react": "^1.64.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.3.0",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
