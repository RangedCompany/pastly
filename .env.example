NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre_cle_publique
# Origine canonique, sans slash final. À renseigner aussi dans Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Activer après configuration du fournisseur Google dans Supabase (voir docs/auth-google.md).
# Le Client ID et le Client Secret Google sont enregistrés dans Supabase uniquement.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Facultatif : tests d'intégration, uniquement sur un projet de test dédié.
# Ne jamais mettre de clé secrète / service_role dans les variables NEXT_PUBLIC_*.
# PASTLY_INTEGRATION_CONFIRM=dedicated-test-project
# PASTLY_TEST_USER_A_EMAIL=
# PASTLY_TEST_USER_A_PASSWORD=
# PASTLY_TEST_USER_B_EMAIL=
# PASTLY_TEST_USER_B_PASSWORD=
